{
  "name": "@jylups/cmmn-moddle",
  "version": "5.1.0",
  "description": "A moddle wrapper for CMMN 1.1",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./resources/*": "./resources/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "all": "run-s lint test",
    "lint": "eslint .",
    "build": "rollup -c",
    "pretest": "run-s build",
    "dev": "npm test -- --watch",
    "test": "mocha --reporter=spec --recursive test",
    "prepare": "run-s build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jylups/cmmn-moddle.git"
  },
  "bugs": {
    "url": "https://github.com/jylups/cmmn-js-env/issues"
  },
  "keywords": [
    "cmmn",
    "moddle",
    "cmmn11",
    "meta-model"
  ],
  "author": {
    "name": "Roman Smirnov",
    "url": "https://github.com/romansmirnov"
  },
  "contributors": [
    {
      "name": "bpmn.io contributors",
      "url": "https://github.com/bpmn-io"
    }
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "chai": "^4.1.2",
    "eslint": "^4.19.1",
    "eslint-plugin-bpmn-io": "^0.5.2",
    "ids": "^0.2.0",
    "jsondiffpatch": "^0.1.4",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.2",
    "rollup": "^4.68.3",
    "xsd-schema-validator": "^0.6.0"
  },
  "dependencies": {
    "min-dash": "^5.1.0",
    "moddle": "^8.2.1",
    "moddle-xml": "^12.3.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
